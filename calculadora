<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Calculadora CLP → COP Compacta</title>
    
    <!-- PWA / App Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="SimuCLP">
    <meta name="mobile-web-app-capable" content="yes">
    
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💎</text></svg>">
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💎</text></svg>">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap');

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            background: #f8fafc;
            perspective: 1000px;
        }

        /* Animación suave */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in { animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

        /* Estilo Glassmorphism más ligero */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.7);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            transform: translateY(-4px) rotateX(1.5deg);
            box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.08);
        }

        .btn-3d {
            transition: all 0.1s ease;
            box-shadow: 0 3px 0px #3730a3;
        }

        .btn-3d:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0px #3730a3;
        }

        .spinning { animation: spin 1s linear infinite; }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        #modalProyeccion {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.3);
            backdrop-filter: blur(6px);
            z-index: 100;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        #modalProyeccion.active { display: flex; }

        canvas { max-height: 180px; }

        .custom-scroll::-webkit-scrollbar { width: 4px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    </style>
</head>
<body class="min-h-screen p-3 md:p-6 lg:p-8">

    <!-- Modal de Proyección -->
    <div id="modalProyeccion" onclick="toggleModal(false)">
        <div class="bg-white/95 backdrop-blur-xl w-full max-w-sm rounded-[2rem] overflow-hidden shadow-2xl border border-white animate-fade-in" onclick="event.stopPropagation()">
            <div class="bg-indigo-600 p-5 text-white text-center">
                <h3 class="font-bold uppercase text-xs tracking-wider">Proyección de Costo Total</h3>
                <p id="modalSubtitulo" class="text-[9px] opacity-80 mt-1">Variación TRM para el retiro actual</p>
            </div>
            <div class="max-h-[50vh] overflow-y-auto custom-scroll">
                <table class="w-full text-left text-[11px]">
                    <thead class="sticky top-0 bg-slate-50/90 text-slate-400 font-bold uppercase border-b border-slate-100">
                        <tr>
                            <th class="px-5 py-3">TRM</th>
                            <th class="px-5 py-3 text-right">Base</th>
                            <th class="px-5 py-3 text-right text-indigo-600">Total + Gastos</th>
                        </tr>
                    </thead>
                    <tbody id="tablaProyeccionBody" class="divide-y divide-slate-50 font-medium text-slate-600 italic">
                    </tbody>
                </table>
            </div>
            <div class="p-4 bg-slate-50 text-center">
                <button onclick="toggleModal(false)" class="text-indigo-600 font-bold text-[10px] uppercase tracking-widest">Cerrar</button>
            </div>
        </div>
    </div>

    <div class="max-w-5xl mx-auto space-y-6">
        <!-- Header -->
        <header class="text-center animate-fade-in">
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Calculadora <span class="text-indigo-600 italic">Smart</span></h1>
            <p class="text-[11px] text-slate-400 font-bold uppercase tracking-widest mt-1">Gestión Eficiente CLP ➔ COP</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-5">
            <!-- Sidebar Compacto -->
            <aside class="lg:col-span-1 space-y-4 animate-fade-in" style="animation-delay: 0.1s">
                <div class="glass-card p-5 rounded-[1.5rem] shadow-sm">
                    <h2 class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-5">Parámetros</h2>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-[9px] font-bold text-slate-400 mb-1 uppercase">Retiro Chile (CLP)</label>
                            <input type="number" id="montoRetiro" value="300000" oninput="ejecutarSimulacion()" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 font-bold text-base focus:ring-2 focus:ring-indigo-100 outline-none transition-all">
                        </div>

                        <div>
                            <label class="block text-[9px] font-bold text-indigo-400 mb-1 uppercase">Cupo Directo (CLP)</label>
                            <input type="number" id="montoCupo" value="50000" oninput="ejecutarSimulacion()" class="w-full bg-indigo-50/30 border border-indigo-50 rounded-xl px-4 py-2.5 font-bold text-base text-indigo-700 focus:ring-2 focus:ring-indigo-100 outline-none transition-all">
                        </div>

                        <div>
                            <label class="block text-[9px] font-bold text-slate-400 mb-1 flex justify-between">
                                TRM Actual
                                <span id="updateTime" class="text-[7px] font-normal lowercase opacity-40"></span>
                            </label>
                            <div class="flex gap-2">
                                <input type="number" step="0.01" id="tipoCambio" value="4.06" oninput="ejecutarSimulacion()" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 font-bold text-sm outline-none focus:ring-2 focus:ring-indigo-100">
                                <button onclick="buscarTRM()" class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md hover:bg-indigo-700 active:scale-90 transition-all">
                                    <svg id="trmIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                </button>
                            </div>
                        </div>

                        <button onclick="ejecutarSimulacion()" class="btn-3d w-full bg-indigo-600 text-white font-bold py-3.5 rounded-xl text-[11px] uppercase tracking-widest hover:bg-indigo-700 transition-colors">
                            Calcular
                        </button>

                        <button onclick="mostrarProyeccionRetiro()" class="w-full bg-white text-slate-400 font-bold py-2 rounded-xl text-[8px] uppercase border border-slate-100 hover:text-indigo-600 transition-all">
                            Proyección de Retiro
                        </button>
                    </div>
                </div>
            </aside>

            <!-- Main Panel Compacto -->
            <main class="lg:col-span-3 space-y-5">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 animate-fade-in" style="animation-delay: 0.2s">
                    <!-- Pago Directo Card -->
                    <div class="glass-card p-6 rounded-[2rem] shadow-sm relative overflow-hidden group">
                        <div class="absolute -right-8 -top-8 w-32 h-32 bg-indigo-50 rounded-full blur-2xl group-hover:bg-indigo-100 transition-colors"></div>
                        <h3 class="text-[9px] font-black text-indigo-400 uppercase tracking-widest mb-5">Análisis Pago Directo</h3>
                        
                        <div class="flex items-end justify-between relative z-10">
                            <div>
                                <span class="text-[8px] text-slate-400 font-bold block mb-1 uppercase">Neto Cupo</span>
                                <div id="valorDirecto" class="text-2xl font-extrabold text-slate-800 tracking-tight">--</div>
                            </div>
                            <div class="bg-indigo-600/5 px-4 py-3 rounded-2xl border border-indigo-50">
                                <span class="text-[8px] text-indigo-600 font-bold block mb-1 uppercase tracking-tight">Con Relación (- $6.500)</span>
                                <div id="valorRelacion" class="text-xl font-bold text-indigo-700 tracking-tight">--</div>
                            </div>
                        </div>
                    </div>

                    <!-- Eficiencia Card -->
                    <div class="glass-card p-4 rounded-[2rem] shadow-sm flex flex-col justify-center">
                        <h2 class="text-[9px] font-black text-slate-400 uppercase text-center mb-3">Eficiencia del Retiro (%)</h2>
                        <div class="relative h-[80px]">
                            <canvas id="chartImpactoMini"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Gran Total Compacto -->
                <section id="resumenTotal" class="animate-fade-in" style="animation-delay: 0.3s">
                    <!-- Inyectado -->
                </section>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 animate-fade-in" style="animation-delay: 0.4s">
                    <div class="glass-card p-6 rounded-[2rem] shadow-sm">
                        <h2 class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-6 text-center">Composición del Gasto</h2>
                        <div class="relative h-[180px]">
                            <canvas id="chartComposicion"></canvas>
                        </div>
                    </div>

                    <div class="glass-card p-6 rounded-[2rem] shadow-sm flex flex-col">
                        <h2 class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-5">Desglose Detallado</h2>
                        <div class="flex-grow">
                             <table class="w-full text-[11px] text-left">
                                <tbody id="tablaCuerpo" class="divide-y divide-slate-50 italic text-slate-500 font-medium">
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-5 pt-4 border-t border-slate-50">
                            <p class="text-[8px] text-slate-300 font-bold uppercase tracking-tight text-center">
                                * TRM Real + Gastos (5.5k CLP / 10k COP) + Ajuste.
                            </p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        let chartDonut = null;
        let chartImpact = null;

        const COM_CLP = 5500;
        const COM_COP = 10000;
        const COM_RELACION_COP = 6500;

        function formatMoneda(valor, moneda = 'COP') {
            return new Intl.NumberFormat(moneda === 'COP' ? 'es-CO' : 'es-CL', {
                style: 'currency',
                currency: moneda,
                minimumFractionDigits: 0
            }).format(valor);
        }

        function toggleModal(show) {
            const modal = document.getElementById('modalProyeccion');
            if (show) modal.classList.add('active');
            else modal.classList.remove('active');
        }

        function mostrarProyeccionRetiro() {
            const body = document.getElementById('tablaProyeccionBody');
            const subtitulo = document.getElementById('modalSubtitulo');
            const montoActual = parseFloat(document.getElementById('montoRetiro').value) || 0;
            
            body.innerHTML = '';
            subtitulo.innerText = `Retiro de ${formatMoneda(montoActual, 'CLP')} + Gastos`;

            for (let trm = 3.8; trm <= 4.71; trm += 0.1) {
                const baseCOP = montoActual * trm;
                const comisionTotal = (COM_CLP * trm) + COM_COP;
                
                body.innerHTML += `
                    <tr class="hover:bg-indigo-50/50 transition-colors">
                        <td class="px-5 py-3 font-bold text-slate-400">${trm.toFixed(1)}</td>
                        <td class="px-5 py-3 text-right text-slate-500 font-medium">${formatMoneda(baseCOP)}</td>
                        <td class="px-5 py-3 text-right text-indigo-700 font-extrabold italic tracking-tight">${formatMoneda(baseCOP + comisionTotal)}</td>
                    </tr>
                `;
            }
            toggleModal(true);
        }

        async function buscarTRM() {
            const icon = document.getElementById('trmIcon');
            icon.classList.add('spinning');
            try {
                const response = await fetch('https://open.er-api.com/v6/latest/CLP');
                const data = await response.json();
                if (data?.rates?.COP) {
                    const trmReal = data.rates.COP.toFixed(2);
                    document.getElementById('tipoCambio').value = trmReal;
                    document.getElementById('updateTime').innerText = `actualizado: ${new Date().toLocaleTimeString()}`;
                    ejecutarSimulacion();
                }
            } catch (e) {
                console.error("Error TRM:", e);
            } finally {
                icon.classList.remove('spinning');
            }
        }

        function ejecutarSimulacion() {
            const mRetiro = parseFloat(document.getElementById('montoRetiro').value) || 0;
            const mCupo = parseFloat(document.getElementById('montoCupo').value) || 0;
            const trm = parseFloat(document.getElementById('tipoCambio').value) || 0;

            const retiroCOP = mRetiro * trm;
            const cupoCOP = mCupo * trm;
            const comisionTotalCOP = (COM_CLP * trm) + COM_COP;
            const granTotalCOP = retiroCOP + cupoCOP + comisionTotalCOP;
            const percComisionChile = ((comisionTotalCOP / (retiroCOP || 1)) * 100).toFixed(2);

            document.getElementById('valorDirecto').innerText = formatMoneda(cupoCOP);
            document.getElementById('valorRelacion').innerText = formatMoneda(cupoCOP - COM_RELACION_COP);

            const resumen = document.getElementById('resumenTotal');
            resumen.innerHTML = `
                <div class="bg-slate-900 text-white p-7 rounded-[2.5rem] shadow-xl flex flex-col md:flex-row justify-between items-center relative overflow-hidden ring-1 ring-white/10">
                    <div class="z-10 text-center md:text-left mb-5 md:mb-0">
                        <span class="text-indigo-400 text-[9px] font-black uppercase tracking-[0.2em]">Total Consolidado</span>
                        <div class="text-4xl font-black mt-1 tracking-tight tabular-nums">${formatMoneda(granTotalCOP)}</div>
                    </div>
                    <div class="z-10 flex gap-8 text-center">
                        <div>
                            <span class="text-slate-500 text-[8px] font-black uppercase block mb-1">Monto Neto</span>
                            <div class="text-xl font-bold tracking-tight text-slate-200 italic">${formatMoneda(retiroCOP + cupoCOP)}</div>
                        </div>
                        <div class="border-l border-slate-800 pl-8">
                            <span class="text-slate-500 text-[8px] font-black uppercase block mb-1">Gastos Fijos</span>
                            <div class="text-xl font-bold text-rose-500 tracking-tight italic">${formatMoneda(comisionTotalCOP)}</div>
                        </div>
                    </div>
                </div>
            `;

            const tabla = document.getElementById('tablaCuerpo');
            tabla.innerHTML = `
                <tr class="hover:bg-slate-50"><td class="px-4 py-3 font-bold text-slate-600">Base Retiro (COP)</td><td class="px-4 py-3 text-right font-bold text-slate-800">${formatMoneda(retiroCOP)}</td></tr>
                <tr class="hover:bg-indigo-50/20"><td class="px-4 py-3 font-bold text-indigo-500 italic">Base Cupo (COP)</td><td class="px-4 py-3 text-right font-bold text-indigo-600">${formatMoneda(cupoCOP)}</td></tr>
                <tr class="bg-rose-50/30"><td class="px-4 py-3 font-bold text-rose-600 uppercase text-[9px]">Comisiones Fijas</td><td class="px-4 py-3 text-right font-bold text-rose-700">${formatMoneda(comisionTotalCOP)}</td></tr>
            `;

            actualizarGraficos(retiroCOP, cupoCOP, comisionTotalCOP, percComisionChile);
        }

        function actualizarGraficos(retiro, cupo, comision, pChile) {
            const ctxDonut = document.getElementById('chartComposicion').getContext('2d');
            const ctxImpact = document.getElementById('chartImpactoMini').getContext('2d');
            
            if (chartDonut) chartDonut.destroy();
            chartDonut = new Chart(ctxDonut, {
                type: 'doughnut',
                data: {
                    labels: ['Retiro', 'Cupo', 'Gastos'],
                    datasets: [{
                        data: [retiro, cupo, comision],
                        backgroundColor: ['#6366f1', '#a5b4fc', '#f43f5e'],
                        borderWidth: 0,
                        borderRadius: 12
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '80%',
                    plugins: { 
                        legend: { position: 'bottom', labels: { boxWidth: 10, padding: 15, font: { family: 'Plus Jakarta Sans', weight: 'bold', size: 9 }, color: '#94a3b8' } }
                    }
                }
            });

            if (chartImpact) chartImpact.destroy();
            chartImpact = new Chart(ctxImpact, {
                type: 'bar',
                data: {
                    labels: [''],
                    datasets: [{
                        data: [pChile],
                        backgroundColor: ['#f43f5e'],
                        borderRadius: 10,
                        barThickness: 12
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { display: false, max: 20 }, y: { display: false } }
                }
            });
        }

        window.onload = () => {
            ejecutarSimulacion();
            document.querySelectorAll('.animate-fade-in').forEach((el, index) => {
                el.style.animationDelay = `${index * 0.08}s`;
            });
        };
    </script>
</body>
</html>
